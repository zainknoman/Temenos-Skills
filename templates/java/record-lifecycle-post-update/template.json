{
  "id": "java/record-lifecycle-post-update", "language": "java", "type": "record-lifecycle-post-update",
  "label": "RecordLifecycle.postUpdateRequest (authorisation routine)",
  "description": "After authorisation, posts an OFS request on another application (servicehook.TransactionData, processed by OFS.MESSAGE.SERVICE).",
  "inputs": [
    {"id": "JAVA_PACKAGE", "label": "Java package", "kind": "javaPackage", "example": "com.samplebank.t24.hook"},
    {"id": "CLASS_NAME", "label": "Class name", "kind": "className", "example": "SampleHook"},
    {"id": "APP", "label": "Application", "kind": "app"},
    {"id": "FIELD", "label": "Field holding the target record id", "kind": "field", "of": "APP"},
    {"id": "TARGET_APP", "label": "Target application", "kind": "app"},
    {"id": "TARGET_VERSION", "label": "Target version (after the comma)", "kind": "text", "example": "SAMPLE.UPDATE"},
    {"id": "TARGET_FIELD", "label": "Target field to set", "kind": "field", "of": "TARGET_APP"},
    {"id": "TARGET_VALUE", "label": "Value to set", "kind": "text", "example": "Y"},
    {"id": "OFS_SOURCE", "label": "OFS.SOURCE id", "kind": "text", "example": "TEST.OFS"}
  ]
}

{
  "id": "java/activity-lifecycle-default",
  "language": "java",
  "type": "activity-lifecycle-default",
  "label": "AA ActivityLifecycle.defaultFieldValues",
  "description": "AA activity hook: defaults an empty field of the arrangement activity before it is shown.",
  "inputs": [
    {
      "id": "JAVA_PACKAGE",
      "label": "Java package",
      "kind": "javaPackage",
      "example": "com.samplebank.t24.hook"
    },
    {
      "id": "CLASS_NAME",
      "label": "Class name",
      "kind": "className",
      "example": "SampleHook"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app",
      "fixed": "AA.ARRANGEMENT.ACTIVITY"
    },
    {
      "id": "FIELD",
      "label": "Field to default",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "DEFAULT_VALUE",
      "label": "Default value",
      "kind": "text",
      "example": "SAMPLE"
    }
  ]
}

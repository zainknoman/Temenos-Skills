{
  "id": "jbc/input-routine",
  "language": "jbc",
  "type": "input-routine",
  "label": "Input routine (INPUT.ROUTINE)",
  "description": "VERSION INPUT.ROUTINE: on commit, flags the field when it is empty. Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field to check",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "ERROR_TEXT",
      "label": "Error message",
      "kind": "text",
      "example": "FIELD IS MANDATORY"
    }
  ]
}

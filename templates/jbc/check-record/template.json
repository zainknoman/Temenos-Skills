{
  "id": "jbc/check-record",
  "language": "jbc",
  "type": "check-record",
  "label": "Check record routine (CHECK.REC.RTN)",
  "description": "VERSION CHECK.REC.RTN: defaults an empty field before the record is shown. Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field to default",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "DEFAULT_VALUE",
      "label": "Default value",
      "kind": "text",
      "example": "1001"
    }
  ]
}

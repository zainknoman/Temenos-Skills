{
  "id": "jbc/de-conversion",
  "language": "jbc",
  "type": "de-conversion",
  "label": "Delivery Engine conversion routine",
  "description": "DE conversion routine: the message field holds a record id; the advice shows one field of that record. Only the advice changes. Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field to show in the advice",
      "kind": "field",
      "of": "APP"
    }
  ]
}

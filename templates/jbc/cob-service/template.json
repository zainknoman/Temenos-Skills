{
  "id": "jbc/cob-service",
  "language": "jbc",
  "type": "cob-service",
  "label": "Multi-threaded COB service (.LOAD / .SELECT / record)",
  "description": "BATCH job for a multi-threaded service: .LOAD opens the file into a named COMMON, .SELECT builds the list of ids whose field equals a value, and the record routine runs once per id. Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Selection field",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "SELECT_VALUE",
      "label": "Value",
      "kind": "text",
      "example": "1001"
    }
  ]
}

{
  "id": "jbc/query-api",
  "language": "jbc",
  "type": "query-api",
  "label": "Query method (SELECT + read)",
  "description": "Component method: selects the records whose field equals the value passed in and returns one row per record, id*value (field-mark separated). Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Selection field",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "RETURN_FIELD",
      "label": "Field to return",
      "kind": "field",
      "of": "APP"
    }
  ]
}

{
  "id": "jbc/id-routine",
  "language": "jbc",
  "type": "id-routine",
  "label": "ID routine (ID.RTN)",
  "description": "VERSION ID.RTN: rejects a record id that does not start with the prefix. Generates the .b routine and its .component declaration.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package",
      "kind": "package",
      "example": "SAMPLE.Api"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "SAMPLE.ROUTINE"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleMethod"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample component method"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "ID_PREFIX",
      "label": "Required id prefix",
      "kind": "text",
      "example": "SMP"
    },
    {
      "id": "ERROR_TEXT",
      "label": "Error message",
      "kind": "text",
      "example": "ID MUST START WITH SMP"
    }
  ]
}

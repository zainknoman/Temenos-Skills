{
  "id": "infobasic/cob-service",
  "language": "infobasic",
  "type": "cob-service",
  "label": "Multi-threaded COB service (.LOAD / .SELECT / record)",
  "description": "BATCH job for a multi-threaded service: .LOAD opens the file into a named COMMON, .SELECT builds the list of ids whose field equals a value, and the record routine runs once per id. R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Selection field",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "SELECT_VALUE",
      "label": "Value",
      "kind": "text",
      "example": "1001"
    }
  ]
}

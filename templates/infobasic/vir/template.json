{
  "id": "infobasic/vir",
  "language": "infobasic",
  "type": "vir",
  "label": "Input routine (VIR)",
  "description": "Record input routine (VERSION INPUT.ROUTINE): rejects the record when a field in R.NEW is empty. R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "ERROR_TEXT",
      "label": "Error message",
      "kind": "text",
      "example": "FIELD IS MANDATORY"
    }
  ]
}

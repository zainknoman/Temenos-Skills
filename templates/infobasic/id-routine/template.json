{
  "id": "infobasic/id-routine",
  "language": "infobasic",
  "type": "id-routine",
  "label": "ID routine (ID.RTN)",
  "description": "VERSION ID.RTN: rejects a record id that does not start with the prefix (ID.NEW, error in E). R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "ID_PREFIX",
      "label": "Required id prefix",
      "kind": "text",
      "example": "SMP"
    },
    {
      "id": "ERROR_TEXT",
      "label": "Error message",
      "kind": "text",
      "example": "ID MUST START WITH SMP"
    }
  ]
}

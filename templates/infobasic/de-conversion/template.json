{
  "id": "infobasic/de-conversion",
  "language": "infobasic",
  "type": "de-conversion",
  "label": "Delivery Engine conversion routine",
  "description": "DE conversion routine (set in the Conversion column of a DE format record): the message field holds a record id; the advice shows one field of that record. Only the advice changes. R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field to show in the advice",
      "kind": "field",
      "of": "APP"
    }
  ]
}

{
  "id": "infobasic/before-auth",
  "language": "infobasic",
  "type": "before-auth",
  "label": "Before auth routine (BEFORE.AUTH.RTN)",
  "description": "VERSION BEFORE.AUTH.RTN: sets a field during authorisation, before the record is written to the live file, so the change is kept without an F.WRITE. R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app"
    },
    {
      "id": "FIELD",
      "label": "Field to set",
      "kind": "field",
      "of": "APP"
    },
    {
      "id": "FIELD_VALUE",
      "label": "Value",
      "kind": "text",
      "example": "Y"
    }
  ]
}

{
  "id": "infobasic/aa-getter",
  "language": "infobasic",
  "type": "aa-getter",
  "label": "AA getter subroutine",
  "description": "AA getter: reads an AA.ARRANGEMENT and returns one of its fields. R25 requires $PACKAGE plus a .component declaration for every routine, so both are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleRoutine"
    },
    {
      "id": "ROUTINE_NAME",
      "label": "Routine name",
      "kind": "routineName",
      "example": "V.SAMPLE.CHECK"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample routine"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    },
    {
      "id": "APP",
      "label": "Application",
      "kind": "app",
      "fixed": "AA.ARRANGEMENT"
    },
    {
      "id": "FIELD",
      "label": "Field to return",
      "kind": "field",
      "of": "APP"
    }
  ]
}

{
  "id": "infobasic/local-table",
  "language": "infobasic",
  "type": "local-table",
  "label": "Local table definition (TEMPLATE + .FIELDS)",
  "description": "A new local application in TAFJ Infobasic style: the main routine sets the table properties ($INSERT I_Table, Table.*) and <TABLE>.FIELDS defines the id, one field, reserved fields and the audit fields (CALL Table.*). R25 requires $PACKAGE plus a .component declaration for both routines, so all three are generated.",
  "inputs": [
    {
      "id": "PACKAGE",
      "label": "Package (R25 requires $PACKAGE for every routine)",
      "kind": "package",
      "example": "SAMPLE.Legacy"
    },
    {
      "id": "METHOD_NAME",
      "label": "Component method",
      "kind": "identifier",
      "example": "sampleParameter"
    },
    {
      "id": "TABLE_NAME",
      "label": "Table name",
      "kind": "text",
      "example": "SAMPLE.PARAMETER"
    },
    {
      "id": "TITLE",
      "label": "Screen title",
      "kind": "text",
      "example": "Sample parameter"
    },
    {
      "id": "PRODUCT",
      "label": "Product (EB.PRODUCT)",
      "kind": "text",
      "example": "EB"
    },
    {
      "id": "EQUATE_PREFIX",
      "label": "Equate prefix",
      "kind": "text",
      "example": "SAMPLE.PRM"
    },
    {
      "id": "ID_LENGTH",
      "label": "Id length",
      "kind": "number",
      "example": "20"
    },
    {
      "id": "FIELD_NAME",
      "label": "First field name",
      "kind": "text",
      "example": "DESCRIPTION"
    },
    {
      "id": "FIELD_LENGTH",
      "label": "First field length",
      "kind": "number",
      "example": "35"
    },
    {
      "id": "DESCRIPTION",
      "label": "Description",
      "kind": "text",
      "example": "Sample parameter table"
    },
    {
      "id": "AUTHOR",
      "label": "Author",
      "kind": "text",
      "example": "developer"
    }
  ]
}
